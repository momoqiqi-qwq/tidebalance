<view class="page-body">
  <!-- 搜索 -->
  <view class="searchbar">
    <input
      class="input"
      placeholder="搜索任务 / 备注 / 项目"
      value="{{q}}"
      confirm-type="search"
      bindinput="onSearch"
    />
  </view>

  <!-- 顶部统计 + 折叠开关 -->
  <view class="chips">
    <view class="chip">全部 <b>{{chips.all}}</b> 项</view>
    <view class="chip">待办 <b>{{chips.open}}</b> 项</view>
    <view class="chip">已完成 <b>{{chips.done}}</b> 项</view>
    <view class="chip toggle {{hideDone ? 'on' : ''}}" hover-class="press" bindtap="onHideDoneTap">
      {{hideDone ? "已隐藏已完成" : "隐藏已完成"}}
    </view>
  </view>

  <!-- 搜索结果 / 象限块 -->
  <block wx:if="{{searching}}">
    <view class="qhead">
      <view class="qh-line"><text class="qh-title">搜索结果 · {{tasks.length}} 个</text></view>
      <view class="qh-tip">匹配标题 / 备注 / 项目，点象限块可返回</view>
    </view>
  </block>
  <block wx:else>
    <view class="qgrid">
      <view
        wx:for="{{quads}}"
        wx:key="q"
        class="qtile {{item.cls}} {{active === item.q ? 'on' : ''}}"
        data-q="{{item.q}}"
        hover-class="press"
        bindtap="onTileTap"
      >
        <view class="qt-top">
          <text class="rn">{{item.rn}}</text>
          <text class="cnt">{{item.open}} 项待办</text>
        </view>
        <view class="qt-name">{{item.short}}</view>
        <view class="qt-tip">{{item.tip}}</view>
      </view>
    </view>

    <view class="qhead {{cur.cls}}">
      <view class="qh-line">
        <text class="rn-big">{{cur.rn}}</text>
        <text class="qh-title">{{cur.title}}</text>
      </view>
      <view class="qh-tip">{{cur.tip}}</view>
    </view>
  </block>

  <!-- 任务列表（左滑出快捷操作） -->
  <view class="tks">
    <view wx:for="{{tasks}}" wx:key="id" class="swipe-wrap">
      <view class="swipe-actions">
        <view class="sa s-done" data-id="{{item.id}}" catchtap="onSwipeDone">{{item.done ? "↩" : "✓"}}</view>
        <view class="sa s-del" data-id="{{item.id}}" catchtap="onSwipeDel">✕</view>
      </view>
      <view
        class="tkc {{item.done ? 'done' : ''}}"
        style="transform: translateX({{item.offset}}px); {{item.moving ? '' : 'transition: transform .18s ease-out;'}}"
        data-id="{{item.id}}"
        data-index="{{item.index}}"
        data-offset="{{item.offset}}"
        hover-class="press"
        bindtap="onCardTap"
        bindtouchstart="onCardTouchStart"
        bindtouchmove="onCardTouchMove"
        bindtouchend="onCardTouchEnd"
      >
        <view class="cb {{item.done ? 'on' : ''}}" data-id="{{item.id}}" catchtap="onCheck">{{item.done ? '✓' : ''}}</view>
        <view class="tbody">
          <view class="tt">
            <text wx:if="{{searching}}" class="qb {{item.quadCls}}">{{item.quadBadge}}</text>
            {{item.title}}
          </view>
          <view
            wx:if="{{item.hasNote}}"
            class="tn {{item.noteOpen ? 'open' : ''}}"
            data-id="{{item.id}}"
            catchtap="onNoteTap"
          >{{item.note}}</view>
          <view class="m">{{item.meta}}</view>
        </view>
        <view class="side">
          <view wx:if="{{item.schedLabel}}" class="sch">{{item.schedLabel}}</view>
          <view class="est">{{item.estLabel}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{!tasks.length}}" class="empty">{{searching ? "没有匹配的任务" : "这个象限还是空的"}}</view>
  </view>

  <!-- 快速添加 -->
  <view wx:if="{{form.show}}" class="addform">
    <input
      class="input"
      placeholder="要做什么？"
      value="{{form.title}}"
      focus="{{form.focus}}"
      confirm-type="done"
      bindinput="onFormInput"
      bindconfirm="onFormSave"
    />
    <view class="formrow">
      <picker mode="selector" range="{{estLabels}}" value="{{form.estIndex}}" bindchange="onEstChange">
        <view class="estpick">预估 {{estLabels[form.estIndex]}} ▾</view>
      </picker>
      <view class="formbtns">
        <button class="btn ghost small" bindtap="onFormCancel">取消</button>
        <button class="btn pri small" bindtap="onFormSave">保存</button>
      </view>
    </view>
  </view>
  <button wx:else class="btn ghost block addbtn" bindtap="onAddTap">＋ 添加到「{{cur.short}}」</button>
</view>

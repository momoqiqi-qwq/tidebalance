/* 时间块（潮汐） */
.press { opacity: 0.8; transform: scale(0.99); }
.tb { padding-bottom: calc(220rpx + env(safe-area-inset-bottom)); }

/* ── 日期导航 ── */
.tl-head { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 24rpx; }
.dnav { display: flex; gap: 10rpx; flex: none; }
.dnav-btn {
  width: 66rpx;
  height: 66rpx;
  border-radius: 14rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--deep);
  box-sizing: border-box;
}
.dlabel { display: flex; flex-direction: column; min-width: 0; }
.dlabel .d { font-size: 30rpx; font-weight: 700; }
.dlabel .sum { font-size: 22rpx; color: var(--ink-2); margin-top: 2rpx; }

/* ── 近 7 天日期条 ── */
.days { margin: 0 4rpx 20rpx; white-space: nowrap; }
.days-inner { display: inline-flex; gap: 12rpx; padding: 2rpx; }
.dchip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  min-width: 96rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: var(--panel);
  box-shadow: 0 2rpx 8rpx rgba(34, 48, 58, 0.05);
  box-sizing: border-box;
}
.dchip .dmd { font-size: 24rpx; font-weight: 600; }
.dchip .dwk { font-size: 19rpx; color: var(--ink-3); }
.dchip.on { background: var(--deep); }
.dchip.on .dmd { color: var(--on-deep); }
.dchip.on .dwk { color: var(--on-deep); opacity: 0.72; }

/* ── 长按放置模式提示条 ── */
.placebar {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 16rpx);
  left: 24rpx;
  right: 24rpx;
  background: var(--deep-2);
  color: #fff;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(13, 31, 38, 0.35);
  z-index: 30;
}
.placebar .pt1 { font-size: 24rpx; line-height: 1.5; }
.placebar .pt2 { flex: none; font-size: 24rpx; padding: 6rpx 14rpx; opacity: 0.85; }

/* ── 空天提示 ── */
.day-empty {
  position: absolute;
  left: 96rpx;
  right: 20rpx;
  top: 45%;
  transform: translateY(-50%);
  text-align: center;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.9;
  pointer-events: none;
}

/* ── 任务池 ── */
.pool { margin-bottom: 22rpx; }
.pt {
  font-size: 22rpx;
  letter-spacing: 0.12em;
  color: var(--ink-2);
  margin: 0 6rpx 12rpx;
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  flex-wrap: wrap;
}
.pt-hint { font-size: 20rpx; letter-spacing: 0; color: var(--ink-3); }
.plist { width: 100%; white-space: nowrap; }
.plist-inner { display: inline-flex; gap: 14rpx; padding: 4rpx 2rpx 8rpx; }
.ptask {
  display: inline-block;
  width: 330rpx;
  white-space: normal;
  background: var(--panel);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 3rpx 12rpx rgba(34, 48, 58, 0.06);
  box-sizing: border-box;
  vertical-align: top;
  min-height: 128rpx;
}
.ptask .n {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.ptask .m {
  display: flex;
  gap: 10rpx;
  font-size: 20rpx;
  color: var(--ink-2);
  margin-top: 8rpx;
  align-items: center;
  flex-wrap: wrap;
}
.pool-empty {
  border: 2rpx dashed var(--line);
  border-radius: 16rpx;
  background: transparent;
  box-shadow: none;
}

/* ── 时间轴画布 ── */
/* 注意：内部 hour-row / movable-area 的 top 均按 px 精确计算，
   垂直方向不能有任何内边距，否则 928px 画布与 movable-area 错位 */
.canvas {
  position: relative;
  overflow: hidden;
  padding: 0;
  box-sizing: border-box;
}
.hour-row {
  position: absolute;
  left: 96rpx;
  right: 20rpx;
  height: 54px;
  border-bottom: 1px solid var(--line-soft);
}
.hour-row .h {
  position: absolute;
  left: -84rpx;
  top: -7px;
  font-size: 20rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}
.ma { position: absolute; top: 10px; bottom: 0; left: 96rpx; right: 20rpx; }
.block {
  width: 100%;
  box-sizing: border-box;
  border-radius: 9px;
  padding: 7px 12px;
  color: var(--on-deep);
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
}
.block .bn {
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.block .bm { font-size: 10px; opacity: 0.85; margin-top: 2px; }
.block.tiny { padding: 4px 10px; }
.block.dragging {
  opacity: 0.78;
  box-shadow: 0 10px 24px rgba(34, 48, 58, 0.4);
}

.now-line {
  position: absolute;
  left: 84rpx;
  right: 36rpx;
  height: 2px;
  background: var(--coral);
  z-index: 5;
  pointer-events: none;
}
.now-line::before {
  content: "";
  position: absolute;
  left: -5px;
  top: -4px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--coral);
}
.now-line .t {
  position: absolute;
  right: 0;
  top: -18px;
  background: var(--coral);
  color: #fff;
  font-size: 10px;
  border-radius: 8px;
  padding: 2px 8px;
  white-space: nowrap;
}
.drop-hint {
  position: absolute;
  left: 88rpx;
  right: 32rpx;
  height: 3px;
  border-radius: 2px;
  background: var(--sea);
  z-index: 6;
  pointer-events: none;
}
.drop-hint .hl {
  position: absolute;
  right: 0;
  top: -24px;
  background: var(--sea);
  color: #fff;
  font-size: 10px;
  padding: 3px 9px;
  border-radius: 8px;
  white-space: nowrap;
}

/* ── 概览 ── */
.at {
  font-size: 22rpx;
  letter-spacing: 0.18em;
  color: var(--ink-2);
  margin-bottom: 14rpx;
}
.bigrow { display: flex; align-items: baseline; gap: 10rpx; margin-bottom: 16rpx; }
.big { font-size: 46rpx; font-weight: 800; color: var(--deep); }
.small { font-size: 22rpx; color: var(--ink-3); }
.meter {
  display: flex;
  height: 14rpx;
  border-radius: 999rpx;
  overflow: hidden;
  gap: 2rpx;
  margin-bottom: 16rpx;
  background: var(--line-soft);
}
.seg { height: 100%; }
.legend { display: flex; flex-wrap: wrap; gap: 10rpx 26rpx; }
.lg { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: var(--ink-2); }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex: none; }

.rhythm { display: flex; gap: 12rpx; align-items: flex-end; }
.r { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.rbar {
  width: 100%;
  height: 120rpx;
  display: flex;
  align-items: flex-end;
  background: var(--paper);
  border-radius: 8rpx;
  overflow: hidden;
}
.fill { width: 100%; background: var(--sea); min-height: 6rpx; }
.r.today .rbar { background: var(--accent-soft); }
.r.today .fill { background: var(--deep); }
.rd { font-size: 19rpx; color: var(--ink-3); }

.trow {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.trow:last-child { border-bottom: none; }
.tlabel {
  flex: 1;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.du { font-size: 21rpx; color: var(--ink-3); flex: none; }

/* ── 底部快速输入 ── */
.addbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  display: flex;
  gap: 14rpx;
  align-items: center;
  background: var(--panel);
  border-radius: 18rpx;
  padding: 14rpx 18rpx;
  box-shadow: 0 8rpx 30rpx rgba(34, 48, 58, 0.16);
  z-index: 20;
}
.addbar .input { flex: 1; background: var(--paper); border: none; }

@media (max-width: 340px) {
  .tl-head { gap: 14rpx; padding: 18rpx 20rpx; }
  .dnav { gap: 8rpx; }
  .dnav-btn { width: 60rpx; height: 60rpx; }
  .dlabel .sum { display: none; }
  .ptask { width: 300rpx; }
  .hour-row { left: 86rpx; right: 14rpx; }
  .ma { left: 86rpx; right: 14rpx; }
  .now-line { left: 74rpx; right: 26rpx; }
  .drop-hint { left: 78rpx; right: 24rpx; }
  .addbar { left: 18rpx; right: 18rpx; padding: 12rpx 14rpx; }
}

/* v0.10.2 时间视图切换 */
.view-tabs { margin-bottom: 18rpx; white-space: nowrap; }
.view-tabs-inner { display: inline-flex; gap: 12rpx; padding: 2rpx; }
.view-tab { display:inline-flex; align-items:center; justify-content:center; padding:14rpx 22rpx; border-radius:14rpx 14rpx 6rpx 6rpx; background:var(--panel); border:2rpx solid var(--line); font-size:22rpx; color:var(--ink-2); box-sizing:border-box; }
.view-tab.on { color:var(--deep); border-color:var(--deep); box-shadow:inset 0 -4rpx 0 var(--deep); font-weight:700; }
.viz-panel { background:var(--panel); border-radius:20rpx; box-shadow:0 4rpx 16rpx rgba(34,48,58,.07); overflow:hidden; margin-bottom:24rpx; }
.viz-head { padding:24rpx 26rpx 18rpx; border-bottom:2rpx solid var(--line-soft); display:flex; flex-direction:column; gap:6rpx; }
.vh-title { font-size:30rpx; font-weight:800; }
.vh-sub { font-size:21rpx; color:var(--ink-3); }

/* 里程碑 */
.ms-scroll { padding:36rpx 0 42rpx; white-space:nowrap; }
.ms-track { display:inline-flex; align-items:flex-start; padding:0 24rpx; }
.ms-cell { width:250rpx; min-height:390rpx; text-align:center; position:relative; display:inline-block; vertical-align:top; }
.ms-stage { margin:0 14rpx 42rpx; min-height:66rpx; border-radius:8rpx 8rpx 0 0; background:#f3f6f8; border-bottom:4rpx solid; display:flex; align-items:center; justify-content:center; font-size:25rpx; font-weight:700; white-space:normal; }
.ms-vline { position:absolute; left:50%; top:66rpx; width:2rpx; height:88rpx; transform:translateX(-50%); }
.ms-arrow { height:74rpx; color:#fff; display:flex; align-items:center; justify-content:center; gap:8rpx; clip-path:polygon(0 0,88% 0,100% 50%,88% 100%,0 100%,12% 50%); }
.ms-year { font-size:34rpx; font-weight:800; }
.ms-md { font-size:18rpx; }
.ms-pin { width:52rpx; height:62rpx; margin:40rpx auto 10rpx; color:#fff; display:flex; align-items:flex-start; justify-content:center; padding-top:8rpx; box-sizing:border-box; clip-path:polygon(0 0,100% 0,100% 74%,50% 100%,0 74%); }
.ms-copy { display:flex; flex-direction:column; gap:8rpx; padding:0 12rpx; white-space:normal; }
.ms-title { font-size:23rpx; font-weight:700; line-height:1.45; }
.ms-sub { font-size:19rpx; color:var(--ink-3); line-height:1.5; }

/* 横向高密度时间轴 */
.chron-scroll { height:850rpx; }
.chron-track { position:relative; height:820rpx; width:3900rpx; }
.chron-axis { position:absolute; left:24rpx; right:24rpx; top:50%; height:16rpx; transform:translateY(-50%); background:linear-gradient(90deg,#b70e2b,#e64f8d,#d346b0,#5944ca,#2465da,#19a45e); }
.chron-event { position:absolute; top:50%; width:200rpx; transform:translateX(-50%); }
.chron-event.left { margin-top:-320rpx; }
.chron-event.right { margin-top:50rpx; }
.chron-card { min-height:180rpx; display:flex; flex-direction:column; gap:8rpx; font-size:18rpx; line-height:1.5; white-space:normal; padding:14rpx; box-sizing:border-box; }
.ct-b { font-size:21rpx; font-weight:700; }
.chron-stem { width:2rpx; height:110rpx; margin:auto; }
.chron-event.right .chron-stem { order:-1; }
.chron-dot { position:absolute; left:50%; width:16rpx; height:16rpx; border-radius:50%; transform:translate(-50%,-50%); }
.chron-event.left .chron-dot { top:310rpx; }
.chron-event.right .chron-dot { top:-42rpx; }
.chron-date { position:absolute; left:50%; transform:translateX(-50%); color:#fff; font-size:18rpx; font-weight:700; padding:6rpx 12rpx; border-radius:4rpx; }
.chron-event.left .chron-date { top:294rpx; }
.chron-event.right .chron-date { top:-58rpx; }

/* 交错卡片时间轴 */
.cards-mobile { position:relative; padding-bottom:28rpx; }
.cards-axis { position:absolute; left:50%; top:110rpx; bottom:30rpx; border-left:4rpx dashed #a99bd2; }
.timeline-card { width:50%; min-height:280rpx; box-sizing:border-box; position:relative; display:flex; }
.timeline-card.left { padding:28rpx 50rpx 20rpx 20rpx; justify-content:flex-end; }
.timeline-card.right { margin-left:50%; padding:28rpx 20rpx 20rpx 50rpx; }
.tm-card { width:100%; border:2rpx solid; border-radius:24rpx; padding:24rpx; display:flex; flex-direction:column; gap:10rpx; box-sizing:border-box; }
.tm-date { font-size:23rpx; font-weight:800; }
.tm-title { font-size:27rpx; font-weight:800; line-height:1.35; }
.tm-sub { font-size:21rpx; color:var(--ink-2); line-height:1.6; }
.tm-link { position:absolute; top:82rpx; width:50rpx; border-top:4rpx dashed; }
.timeline-card.left .tm-link { right:0; }
.timeline-card.right .tm-link { left:0; }

/* 年度甘特 */
.gantt-mobile-scroll { width:100%; }
.gantt-mobile { width:1900rpx; padding:20rpx; box-sizing:border-box; }
.gm-head, .gm-row { display:grid; grid-template-columns:320rpx 1fr; min-height:76rpx; border-left:2rpx solid var(--line); border-top:2rpx solid var(--line); }
.gm-head { grid-template-columns:320rpx repeat(12,1fr); }
.gm-label { padding:12rpx 16rpx; border-right:2rpx solid var(--line); border-bottom:2rpx solid var(--line); display:flex; flex-direction:column; justify-content:center; font-size:21rpx; overflow:hidden; }
.gm-group { font-size:18rpx; color:var(--ink-3); }
.gm-month { display:flex; align-items:center; justify-content:center; background:#f1f1f1; border-right:2rpx solid var(--line); border-bottom:2rpx solid var(--line); font-size:19rpx; font-weight:700; }
.gm-cells { position:relative; display:grid; grid-template-columns:repeat(12,1fr); border-bottom:2rpx solid var(--line); }
.gm-cell { border-right:2rpx solid var(--line-soft); }
.gm-bar { position:absolute; top:18rpx; height:40rpx; line-height:40rpx; min-width:30rpx; color:#fff; font-size:18rpx; padding:0 12rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; box-sizing:border-box; }

/* 分类泳道 */
.swim-mobile-scroll { width:100%; }
.swim-mobile { width:2000rpx; padding:20rpx; box-sizing:border-box; }
.sm-row { display:grid; grid-template-columns:220rpx 1fr; min-height:150rpx; border:2rpx solid #d4dfdf; border-top:0; }
.sm-row:first-child { border-top:2rpx solid #d4dfdf; }
.sm-label { color:#fff; font-size:28rpx; font-weight:800; display:flex; align-items:center; justify-content:center; }
.sm-label.cat-work { background:#168f88; }.sm-label.cat-study{background:#26b99a}.sm-label.cat-sport{background:#e28aa1}.sm-label.cat-life{background:#6b8be0}.sm-label.cat-rest{background:#5bbf8f}
.sm-cells { position:relative; display:grid; grid-template-columns:repeat(31,1fr); background:#eef5f5; }
.sm-cell { border-left:2rpx solid #d8e2e2; }
.sm-bar { position:absolute; top:50rpx; height:48rpx; line-height:48rpx; min-width:90rpx; color:#fff; font-size:18rpx; padding:0 12rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; box-sizing:border-box; }

@media (max-width: 340px) {
  .view-tab { padding:12rpx 18rpx; }
  .timeline-card, .timeline-card.right { width:100%; margin-left:0; padding-left:80rpx; padding-right:18rpx; justify-content:flex-start; }
  .cards-axis { left:42rpx; }
  .timeline-card.left .tm-link, .timeline-card.right .tm-link { left:42rpx; right:auto; width:38rpx; }
}

/* v0.11.2 WakeUp 风格周课表（小程序）：横向滚动保留 7 列，不压缩课程文字 */
.wk-mini-scroll{width:100%;height:1250rpx}.wk-mini-grid{width:1740rpx;height:1190rpx;display:flex;padding:18rpx;box-sizing:border-box;background:rgba(255,255,255,.58)}
.wk-mini-timecol{width:105rpx;flex:none;position:relative;border-right:2rpx solid var(--line);height:1180rpx}.wk-mini-day{width:230rpx;flex:none;border-right:2rpx solid var(--line);height:1180rpx;position:relative}.wk-mini-day.today .wk-mini-head{background:rgba(15,76,92,.12);color:var(--deep)}
.wk-mini-head{height:92rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4rpx;border-bottom:2rpx solid var(--line);font-size:22rpx;font-weight:700;box-sizing:border-box}.wk-mini-head text:last-child{font-size:18rpx;color:var(--ink-3)}
.wk-mini-timecol .wk-mini-head{font-size:20rpx;color:var(--ink-2)}.wk-hour{position:absolute;right:12rpx;transform:translateY(-8rpx);font-size:18rpx;color:var(--ink-3);font-variant-numeric:tabular-nums}
.wk-mini-lane{height:1088rpx;position:relative;background:rgba(255,255,255,.34);overflow:hidden}.wk-mini-line{position:absolute;left:0;right:0;border-top:2rpx solid rgba(160,170,175,.18)}
.wk-mini-course{position:absolute;left:8rpx;right:8rpx;border:2rpx solid;border-left-width:7rpx;border-radius:12rpx;padding:9rpx 8rpx;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;overflow:hidden}.wk-mini-title{font-size:20rpx;font-weight:700;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.wk-mini-meta{font-size:16rpx;color:var(--ink-2);margin-top:4rpx;white-space:nowrap}

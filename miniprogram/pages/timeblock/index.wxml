<view class="page-body tb">
  <scroll-view class="view-tabs" scroll-x show-scrollbar="{{false}}">
    <view class="view-tabs-inner">
      <view wx:for="{{viewTabs}}" wx:key="id" class="view-tab {{viewMode === item.id ? 'on' : ''}}" data-mode="{{item.id}}" bindtap="onViewTap">{{item.label}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{viewMode === 'day'}}" class="day-view">
  <!-- 长按放置模式提示条 -->
  <view wx:if="{{placing}}" class="placebar">
    <view class="pt1">放置「{{placing.title}}」· 在时间轴上点一下开始的位置</view>
    <view class="pt2" hover-class="press" bindtap="onPlaceCancel">取消</view>
  </view>

  <!-- 日期导航 -->
  <view class="tl-head card">
    <view class="dnav">
      <view class="dnav-btn" hover-class="press" bindtap="onPrevDay">‹</view>
      <view class="dnav-btn" hover-class="press" bindtap="onToday">◎</view>
      <view class="dnav-btn" hover-class="press" bindtap="onNextDay">›</view>
    </view>
    <picker mode="date" value="{{curDate}}" bindchange="onDateChange">
      <view class="dlabel">
        <text class="d">{{dateLabel}}</text>
        <text class="sum">{{sumLabel}}</text>
      </view>
    </picker>
  </view>

  <!-- 近 7 天日期条 -->
  <scroll-view class="days" scroll-x show-scrollbar="{{false}}">
    <view class="days-inner">
      <view
        wx:for="{{daysBar}}"
        wx:key="date"
        class="dchip {{item.active ? 'on' : ''}}"
        data-date="{{item.date}}"
        hover-class="press"
        bindtap="onDayTap"
      >
        <text class="dmd">{{item.md}}</text>
        <text class="dwk">{{item.wk}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 任务池 -->
  <view class="pool">
    <view class="pt">待安排 · {{pool.length}} 件<text class="pt-hint">点卡片自动安排 · 长按可放到指定时间</text></view>
    <scroll-view wx:if="{{pool.length}}" class="plist" scroll-x show-scrollbar="{{false}}">
      <view class="plist-inner">
        <view
          wx:for="{{pool}}"
          wx:key="id"
          class="ptask"
          hover-class="press"
          data-id="{{item.id}}"
          bindtap="onPoolTap"
          bindlongpress="onPoolLongPress"
        >
          <view class="n">{{item.title}}</view>
          <view class="m">
            <text class="cat-pill cat-{{item.cat}}">{{item.catLabel}}</text>
            <text>{{item.estLabel}}</text>
            <text wx:if="{{item.dueLabel}}">{{item.dueLabel}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
    <view wx:else class="empty pool-empty">全部安排完了</view>
  </view>

  <!-- 时间轴 -->
  <view class="canvas card" style="height:{{canvasH}}px" bindtap="onCanvasTap">
    <view wx:for="{{hours}}" wx:key="top" class="hour-row" style="top:{{item.top}}px">
      <text class="h">{{item.label}}</text>
    </view>
    <view wx:if="{{emptyDay}}" class="day-empty">
      <view>这一天还是空的</view>
      <view>点空白处加一段 · 或点上方任务卡自动安排</view>
    </view>
    <movable-area class="ma">
      <movable-view
        wx:for="{{blocks}}"
        wx:key="id"
        class="block cat-{{item.cat}} {{item.tiny ? 'tiny' : ''}} {{item.id === dragId ? 'dragging' : ''}}"
        style="height:{{item.h}}px"
        direction="vertical"
        damping="60"
        x="0"
        y="{{item.y}}"
        data-id="{{item.id}}"
        bindtouchstart="onBlockTouchStart"
        bindchange="onBlockChange"
        bindtouchend="onBlockTouchEnd"
      >
        <view class="bn">{{item.title}}</view>
        <view wx:if="{{item.showMeta}}" class="bm">{{item.timeLabel}} · {{item.catLabel}}</view>
      </movable-view>
    </movable-area>
    <view wx:if="{{nowLine.show}}" class="now-line" style="top:{{nowLine.top}}px">
      <text class="t">{{nowLine.label}}</text>
    </view>
    <view wx:if="{{hint.show}}" class="drop-hint" style="top:{{hint.top}}px">
      <text class="hl">{{hint.label}}</text>
    </view>
  </view>

  <!-- 概览 -->
  <view class="card">
    <view class="at">这 天 已 排</view>
    <view class="bigrow">
      <text class="big">{{totalLabel}}</text>
      <text class="small">/ {{awakeLabel}} 清醒时间</text>
    </view>
    <view class="meter" wx:if="{{meter.length}}">
      <view wx:for="{{meter}}" wx:key="cat" class="seg cat-{{item.cat}}" style="width:{{item.w}}%"></view>
    </view>
    <view class="legend">
      <view wx:for="{{legend}}" wx:key="cat" class="lg">
        <view class="dot cat-{{item.cat}}"></view>
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="at">近 7 天节奏</view>
    <view class="rhythm">
      <view wx:for="{{rhythm}}" wx:key="i" class="r {{item.today ? 'today' : ''}}">
        <view class="rbar"><view class="fill" style="height:{{item.h}}%"></view></view>
        <text class="rd">{{item.day}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="at">明 天 预 告</view>
    <view wx:if="{{tomEmpty}}" class="empty">明天还是空的，去安排一下吧</view>
    <view wx:for="{{tomorrow}}" wx:key="id" class="trow">
      <view class="dot cat-{{item.cat}}"></view>
      <text class="tlabel">{{item.label}}</text>
      <text class="du">{{item.dur}}</text>
    </view>
  </view>

  <!-- 底部快速输入 -->
  <view class="addbar">
    <input
      class="input"
      placeholder="加一段空白时间，如「午休」"
      value="{{quick}}"
      confirm-type="done"
      bindinput="onQuickInput"
      bindconfirm="onQuickAdd"
    />
    <button class="btn pri small" bindtap="onQuickAdd">添加</button>
  </view>
  </view>

  <view wx:elif="{{viewMode === 'wakeup'}}" class="viz-panel wakeup-mini-panel">
    <view class="viz-head"><text class="vh-title">WakeUp 课表周视图</text><text class="vh-sub">{{wakeupWeekLabel}} · 本周时间块按课表方式排列</text></view>
    <scroll-view class="wk-mini-scroll" scroll-x>
      <view class="wk-mini-grid">
        <view class="wk-mini-timecol">
          <view class="wk-mini-head">时间</view>
          <view class="wk-hour" wx:for="{{wakeupHours}}" wx:key="label" style="top:{{item.top + 92}}rpx">{{item.label}}</view>
        </view>
        <view wx:for="{{wakeupDays}}" wx:key="date" class="wk-mini-day {{item.today ? 'today' : ''}}">
          <view class="wk-mini-head"><text>{{item.name}}</text><text>{{item.md}}</text></view>
          <view class="wk-mini-lane">
            <view wx:for="{{wakeupHours}}" wx:key="label" class="wk-mini-line" style="top:{{item.top}}rpx"></view>
            <view wx:for="{{item.blocks}}" wx:key="id" class="wk-mini-course" style="top:{{item.top}}rpx;height:{{item.height}}rpx;background:{{item.color}}33;border-color:{{item.color}}">
              <text class="wk-mini-title">{{item.title}}</text><text class="wk-mini-meta">{{item.meta}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:elif="{{viewMode === 'milestone'}}" class="viz-panel">
    <view class="viz-head"><text class="vh-title">里程碑时间轴</text><text class="vh-sub">彩色箭头式阶段时间轴</text></view>
    <scroll-view class="ms-scroll" scroll-x>
      <view class="ms-track">
        <view wx:for="{{visualEvents}}" wx:key="index" class="ms-cell" style="--ms:{{item.color}}">
          <view class="ms-stage" style="border-color:{{item.color}}">{{item.catLabel}}</view>
          <view class="ms-vline" style="background:{{item.color}}"></view>
          <view class="ms-arrow" style="background:{{item.color}}"><text class="ms-year">{{item.year}}</text><text class="ms-md">{{item.md}}</text></view>
          <view class="ms-pin" style="background:{{item.color}}">●</view>
          <view class="ms-copy"><text class="ms-title">{{item.title}}</text><text class="ms-sub">{{item.sub}}</text></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:elif="{{viewMode === 'chronicle'}}" class="viz-panel">
    <view class="viz-head"><text class="vh-title">横向时间轴</text><text class="vh-sub">高密度长期事件年表</text></view>
    <scroll-view class="chron-scroll" scroll-x>
      <view class="chron-track">
        <view class="chron-axis"></view>
        <view wx:for="{{visualEvents}}" wx:key="index" class="chron-event {{item.side}}" style="left:{{40 + index * 220}}rpx;--ec:{{item.color}}">
          <view class="chron-card"><text class="ct-b">{{item.title}}</text><text>{{item.date}} · {{item.sub}}</text></view>
          <view class="chron-stem" style="background:{{item.color}}"></view>
          <view class="chron-dot" style="background:{{item.color}}"></view>
          <view class="chron-date" style="background:{{item.color}}">{{item.md}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:elif="{{viewMode === 'cards'}}" class="viz-panel cards-mobile">
    <view class="viz-head"><text class="vh-title">卡片时间轴</text><text class="vh-sub">左右交错的阶段说明卡片</text></view>
    <view class="cards-axis"></view>
    <view wx:for="{{visualEvents}}" wx:key="index" class="timeline-card {{item.side}}" style="--ct:{{item.color}}">
      <view class="tm-card" style="background:{{item.color}}22;border-color:{{item.color}}">
        <text class="tm-date">{{item.date}}</text><text class="tm-title">{{item.title}}</text><text class="tm-sub">{{item.sub}}</text>
      </view>
      <view class="tm-link" style="border-color:{{item.color}}"></view>
    </view>
  </view>

  <view wx:elif="{{viewMode === 'gantt'}}" class="viz-panel">
    <view class="viz-head"><text class="vh-title">年度甘特图</text><text class="vh-sub">任务起止映射到 1-12 月</text></view>
    <scroll-view class="gantt-mobile-scroll" scroll-x>
      <view class="gantt-mobile">
        <view class="gm-head"><view class="gm-label">项目 / 任务</view><view wx:for="{{12}}" wx:key="index" class="gm-month">{{index + 1}}月</view></view>
        <view wx:for="{{visualGantt}}" wx:key="index" class="gm-row">
          <view class="gm-label"><text class="gm-group">{{item.group}}</text><text>{{item.title}}</text></view>
          <view class="gm-cells"><view wx:for="{{12}}" wx:key="index" class="gm-cell"></view><view class="gm-bar" style="left:{{item.left}}%;width:{{item.width}}%;background:{{item.color}}">{{item.title}}</view></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:else class="viz-panel">
    <view class="viz-head"><text class="vh-title">阶段甘特图</text><text class="vh-sub">按工作 / 学习 / 运动 / 生活 / 休息分泳道</text></view>
    <scroll-view class="swim-mobile-scroll" scroll-x>
      <view class="swim-mobile">
        <view wx:for="{{visualSwim}}" wx:key="cat" class="sm-row">
          <view class="sm-label cat-{{item.cat}}">{{item.label}}</view>
          <view class="sm-cells"><view wx:for="{{31}}" wx:key="index" class="sm-cell"></view><view wx:for="{{item.bars}}" wx:key="index" class="sm-bar" style="left:{{item.left}}%;width:{{item.width}}%;background:{{item.color}}">{{item.title}}</view></view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

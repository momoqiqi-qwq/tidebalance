<view class="page-body elder {{careSettings.large ? 'extra-large' : ''}}">
  <view class="elder-mode"><image class="care-icon" src="/images/tab/elder-on.png" />安心日常</view>
  <view class="hero">
    <view>
      <view class="eyebrow">大 字 · 少 步 骤</view>
      <view class="h1">今天，慢慢来就好</view>
      <view class="sub">不赶进度，照顾好自己就很好。</view>
    </view>
    <view class="next">{{nextLabel}}</view>
  </view>

  <button class="mini" bindtap="onLarge">{{careSettings.large ? "标准大字" : "字再大一点"}}</button>
  <view class="tabs">
    <view class="tab {{tab === 'today' ? 'on' : ''}}" data-tab="today" bindtap="onTab">今天的安排</view>
    <view class="tab {{tab === 'reminders' ? 'on' : ''}}" data-tab="reminders" bindtap="onTab">添加提醒</view>
    <view class="tab {{tab === 'hardware' || tab === 'sites' ? 'on' : ''}}" data-tab="hardware" bindtap="onTab">家人协助</view>
  </view>
  <block wx:if="{{tab === 'today'}}">
    <button class="btn ghost block" bindtap="onReadToday">听听今天的安排</button>
    <view class="card" wx:for="{{todayItems}}" wx:key="key">
      <view class="rt">{{item.displayTime}}</view>
      <view class="rn">{{item.title}}</view>
      <view class="rm">{{item.message || "一件一件来，不用着急。"}}</view>
      <view class="note" wx:if="{{item.status === 'done'}}">今天已做好</view>
      <view class="btnrow">
        <button class="btn pri" data-key="{{item.key}}" data-done="{{item.status === 'done'}}" bindtap="onDone">{{item.status === 'done' ? "撤销完成" : "我做好了"}}</button>
        <button wx:if="{{item.status !== 'done'}}" class="btn ghost" data-key="{{item.key}}" bindtap="onSnooze">10 分钟后提醒</button>
        <button class="mini" data-id="{{item.id}}" bindtap="onRead">读给我听</button>
      </view>
    </view>
    <view wx:if="{{!todayItems.length}}" class="card empty">先加一件熟悉的小事，按自己的节奏来。<button class="btn pri" data-tab="reminders" bindtap="onTab">添加我的提醒</button></view>
    <button class="btn ghost block" bindtap="onCallFamily">联系{{careSettings.contactName || "家人"}}</button>
  </block>
  <block wx:elif="{{tab === 'sites'}}">
    <view class="card">
      <view class="at">养老必须网站</view>
      <view class="site" wx:for="{{sites}}" wx:key="id">
        <view class="sn">{{item.name}}</view>
        <view class="sm">{{item.tag}} · {{item.host}}</view>
        <view class="apphint">建议打开：{{item.appHint}}</view>
        <view class="site-actions">
          <button class="mini pri-mini" data-i="{{index}}" bindtap="onOpenSite">智能引导</button>
          <button class="mini" data-i="{{index}}" bindtap="onCopySite">复制链接</button>
          <button class="mini" data-i="{{index}}" bindtap="onBrowserGuide">浏览器打开</button>
          <button class="mini" data-i="{{index}}" bindtap="onOpenApp">已有 App</button>
          <button class="mini contact" open-type="contact" show-message-card="true" send-message-title="{{item.name}}" send-message-path="/pages/elder/index">客服协助</button>
        </view>
      </view>
      <view class="note">入口会先复制链接，再提示去浏览器或已有 App 打开；需要人工帮助时可点“客服协助”发送当前办事入口。</view>
    </view>
  </block>

  <block wx:elif="{{tab === 'hardware'}}">
    <view class="card">
      <view class="at">家人协助设置</view>
      <view class="desc">设置好后，让长辈回到“今天的安排”。</view>
      <input class="input" placeholder="家人的称呼" value="{{careSettings.contactName}}" data-k="contactName" bindinput="onContactInput" />
      <input class="input" type="text" placeholder="家人电话号码" value="{{careSettings.contactPhone}}" data-k="contactPhone" bindinput="onContactInput" />
      <button class="btn pri block" bindtap="onSaveContact">保存联系方式</button>
      <view class="note">到点朗读 <switch checked="{{careSettings.voice}}" bindchange="onVoiceEnabled" /></view>
      <view wx:if="{{!voiceAvailable}}" class="note">语音服务尚未开通；可以用输入法麦克风输入。家人可按接入文档开通微信同声传译。</view>
      <button class="btn ghost block" data-tab="sites" bindtap="onTab">养老办事入口</button>
    </view>
    <view class="card">
      <view class="at">管理提醒</view>
      <view class="rrow" wx:for="{{reminders}}" wx:key="id">
        <view class="rn">{{item.time}} {{item.title}}</view>
        <view class="rm">{{item.repeatLabel}} · {{item.enabled ? '已开启' : '已暂停'}}</view>
        <view class="ra">
          <button class="mini" data-id="{{item.id}}" bindtap="onEdit">修改</button>
          <button class="mini" data-id="{{item.id}}" bindtap="onTestReminder">试听</button>
          <button class="mini" data-id="{{item.id}}" bindtap="onToggle">{{item.enabled ? '暂停' : '开启'}}</button>
          <button class="mini danger" data-id="{{item.id}}" bindtap="onRemove">删除</button>
        </view>
      </view>
    </view>
    <view class="card">
      <view class="at">音箱和智能药盒</view>
      <view class="desc">连接家庭网关，把提醒交给房间里的设备。开启后会把提醒标题和内容发送给该地址。</view>
      <view class="rrow" wx:for="{{devices}}" wx:key="id">
        <view class="rn">{{item.name}}</view><view class="rm">{{item.lastStatus || '尚未测试'}}</view>
        <view class="ra"><button class="mini" data-id="{{item.id}}" bindtap="onTestDevice">测试设备</button><button class="mini" data-id="{{item.id}}" bindtap="onToggleDevice">{{item.enabled ? '关闭到点发送' : '开启到点发送'}}</button><button class="mini" data-id="{{item.id}}" bindtap="onDeleteDevice">移除</button></view>
      </view>
      <input class="input" placeholder="设备名称，例如：客厅音箱" value="{{gateway.name}}" data-k="name" bindinput="onGatewayInput" />
      <input class="input" placeholder="家庭网关 HTTPS 地址" value="{{gateway.url}}" data-k="url" bindinput="onGatewayInput" />
      <input class="input" password placeholder="访问令牌（可选）" value="{{gateway.token}}" data-k="token" bindinput="onGatewayInput" />
      <button class="btn pri block" bindtap="onSaveGateway">保存设备</button>
      <view class="note">网关需配置为小程序的合法请求域名；接收成功不代表长辈已听到。全天提醒由家庭设备或服务负责。</view>
    </view>
    <view class="card">
      <view class="at">蓝牙硬件联动</view>
      <view class="desc">到点后，小程序会把提醒文本写给已连接的蓝牙设备。硬件可负责响铃、亮灯，或提示长辈给子女发送平安消息。</view>
      <view class="form">
        <input class="input" placeholder="子女姓名，如：小张" value="{{ble.childName}}" data-k="childName" bindinput="onBleInput" />
        <input class="input" placeholder="联系方式或设备识别码" value="{{ble.childContact}}" data-k="childContact" bindinput="onBleInput" />
        <input class="input" placeholder="设备名称关键词，可留空" value="{{ble.namePrefix}}" data-k="namePrefix" bindinput="onBleInput" />
        <input class="input" placeholder="Service UUID" value="{{ble.serviceId}}" data-k="serviceId" bindinput="onBleInput" />
        <input class="input" placeholder="Characteristic UUID" value="{{ble.characteristicId}}" data-k="characteristicId" bindinput="onBleInput" />
      </view>
      <view class="btnrow">
        <button class="btn pri" bindtap="onSaveBle">保存设置</button>
        <button class="btn ghost" bindtap="onConnectBle">连接蓝牙</button><button class="btn ghost" bindtap="onTestBle">测试蓝牙提醒</button>
      </view>
      <view class="note">到点发给蓝牙设备 <switch checked="{{ble.enabled}}" bindchange="onBleEnabled" /></view>
      <view class="note">{{bleStatus}}</view>
    </view>
  </block>

  <block wx:else>
    <view class="card">
      <view class="at">养老常用预设</view>
      <view class="presets">
        <view class="preset" wx:for="{{presets}}" wx:key="title" data-i="{{index}}" hover-class="press" bindtap="onPreset">
          <view class="pn">{{item.time}} · {{item.title}}</view>
          <view class="pm">{{item.message}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="at">{{editId ? "修改提醒" : "记住一件小事"}}</view>
      <button class="btn ghost block" bindtap="onVoice">{{voiceStatus || "说出提醒"}}</button>
      <view class="note">语音由微信同声传译处理；请核对文字和时间后保存。</view>
      <input class="input" placeholder="要提醒什么？如：喝水、复诊、联系子女" value="{{form.title}}" data-k="title" bindinput="onFormInput" />
      <button class="mini" bindtap="onParse">识别这句话的时间</button>
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange"><view class="pick">日期 {{form.date}}（仅一次时使用）</view></picker>
      <view class="twocol">
        <picker mode="time" value="{{form.time}}" bindchange="onTimeChange"><view class="pick">时间 {{form.time}}</view></picker>
        <picker mode="selector" range="{{repeatLabels}}" value="{{form.repeatIndex}}" bindchange="onRepeatChange"><view class="pick">{{repeatLabels[form.repeatIndex]}}</view></picker>
      </view>
      <textarea class="textarea msg" placeholder="提醒内容，也会发送给蓝牙硬件" value="{{form.message}}" data-k="message" bindinput="onFormInput"></textarea>
      <button class="btn pri block" bindtap="onAddReminder">保存提醒</button><button wx:if="{{editId}}" class="btn ghost block" bindtap="onCancelEdit">取消修改</button>
    </view>

  </block>
  <view class="note">小程序打开时提供提醒。关闭后本地提醒可能停止，全天提醒需由家庭设备或服务负责。</view>
</view>

.elder {
  padding-bottom: calc(84rpx + env(safe-area-inset-bottom));
  background: #F8F3E7;
}
.press { opacity: 0.9; transform: scale(0.992); transition: transform 80ms linear; }
.elder-mode {
  display: inline-flex;
  align-items: center;
  min-height: 54rpx;
  padding: 0 24rpx;
  margin: 4rpx 0 18rpx;
  border-radius: 999rpx;
  background: #16586A;
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
}
.hero {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: flex-end;
  background: var(--panel);
  border: 3rpx solid #E4D7BF;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 2rpx 12rpx rgba(51, 40, 20, 0.08);
}
.eyebrow { font-size: 26rpx; letter-spacing: 0.12em; color: #52646C; margin-bottom: 10rpx; }
.h1 { font-size: 48rpx; font-weight: 900; line-height: 1.18; }
.sub { font-size: 32rpx; color: #52646C; line-height: 1.55; margin-top: 14rpx; }
.next {
  flex: none;
  max-width: 220rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border: 3rpx solid #D8C8AC;
  border-radius: 22rpx;
  padding: 18rpx 22rpx;
  font-size: 30rpx;
  color: #16586A;
  font-weight: 800;
  line-height: 1.5;
}
.tabs { display: flex; gap: 14rpx; margin-bottom: 22rpx; }
.tab {
  flex: 1;
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--panel);
  border: 2rpx solid var(--line);
  border: 3rpx solid #D8C8AC;
  border-radius: 20rpx;
  font-size: 34rpx;
  color: #52646C;
  font-weight: 800;
}
.tab.on { background: #16586A; color: #fff; border-color: #16586A; }
.at { font-size: 32rpx; font-weight: 900; letter-spacing: 0; color: #17262C; margin-bottom: 20rpx; }
.site {
  padding: 26rpx 0 28rpx;
  border-bottom: 1rpx solid var(--line-soft);
}
.site:last-of-type { border-bottom: none; }
.sn { font-size: 36rpx; font-weight: 900; line-height: 1.35; }
.sm { font-size: 28rpx; color: #16586A; margin-top: 8rpx; font-weight: 700; }
.apphint {
  font-size: 28rpx;
  color: #52646C;
  line-height: 1.5;
  margin-top: 8rpx;
}
.site-actions {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-top: 14rpx;
}
.note {
  font-size: 28rpx;
  color: #52646C;
  line-height: 1.7;
  background: var(--paper);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-top: 22rpx;
}
.presets { display: grid; grid-template-columns: 1fr; gap: 16rpx; }
.preset {
  background: var(--paper);
  border: 3rpx solid #D8C8AC;
  border-radius: 22rpx;
  padding: 24rpx;
  min-height: 154rpx;
  box-sizing: border-box;
}
.pn { font-size: 34rpx; font-weight: 900; line-height: 1.35; }
.pm {
  font-size: 28rpx;
  color: #52646C;
  line-height: 1.5;
  margin-top: 6rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.twocol { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin: 14rpx 0; }
.pick {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  background: var(--paper);
  border: 3rpx solid #D8C8AC;
  border-radius: 18rpx;
  padding: 0 24rpx;
  color: #16586A;
  font-size: 34rpx;
  font-weight: 800;
}
.msg { margin-bottom: 16rpx; }
.rrow {
  display: grid;
  grid-template-columns: 144rpx 1fr;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.rrow:last-child { border-bottom: none; }
.rt { font-size: 44rpx; font-weight: 900; color: #16586A; font-variant-numeric: tabular-nums; }
.rn { font-size: 34rpx; font-weight: 900; line-height: 1.35; }
.rm { font-size: 28rpx; color: #52646C; line-height: 1.55; margin-top: 6rpx; }
.ra { grid-column: 1 / -1; display: flex; gap: 14rpx; flex-wrap: wrap; }
.mini {
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: var(--paper);
  color: #16586A;
  font-size: 30rpx;
  font-weight: 800;
  margin: 0;
}
.mini::after { border: none; }
.mini.pri-mini { background: #16586A; color: #fff; }
.mini.contact { background: #f4fbf8; color: #176b50; }
.mini.danger { background: var(--danger-bg); color: var(--danger-ink); }
.form { display: flex; flex-direction: column; gap: 18rpx; }
.btnrow { display: flex; gap: 14rpx; margin-top: 22rpx; }
.btnrow .btn { flex: 1; }
.elder .btn {
  min-height: 104rpx;
  border-radius: 20rpx;
  font-size: 34rpx;
  font-weight: 900;
}
.elder .input,
.elder .textarea {
  min-height: 104rpx;
  border: 3rpx solid #D8C8AC;
  border-radius: 18rpx;
  font-size: 34rpx;
  padding: 20rpx 24rpx;
}
.elder .textarea {
  min-height: 190rpx;
  line-height: 1.5;
}

@media (max-width: 340px) {
  .hero { flex-direction: column; align-items: stretch; }
  .next { max-width: none; }
  .twocol { grid-template-columns: 1fr; }
}
/* Calm, readable elder home. */
.elder { background:#F4F8FA; color:#153B46; font-size:36rpx; }
.care-icon { width:54rpx; height:54rpx; margin-right:14rpx; background:#fff; border-radius:50%; }
.elder-mode { display:inline-flex; align-items:center; background:#15566B; }
.hero { display:block; background:#E8F2F6; border-color:#BCD4DF; }
.h1 { font-size:52rpx; line-height:1.4; }
.next { margin-top:22rpx; }
.tabs { margin-top:24rpx; flex-wrap:nowrap; gap:8rpx; }
.tab { flex:1; padding:22rpx 10rpx; font-size:32rpx; text-align:center; }
.card { margin:24rpx 0; background:#fff; border:2rpx solid #CADCE2; }
.elder .btn, .elder .mini { min-height:96rpx; height:auto; padding:18rpx 20rpx; font-size:34rpx; line-height:1.4; border-radius:18rpx; }
.elder .btn.pri { background:#15566B; color:#fff; }
.elder .btn.ghost, .elder .mini { background:#F2F7F9; color:#15566B; border:2rpx solid #BDD0D8; }
.elder .input, .elder .textarea { margin-bottom:18rpx; min-height:94rpx; height:auto; font-size:36rpx; background:#fff; color:#153B46; border:2rpx solid #BCD0DA; }
.elder .textarea { min-height:180rpx; }
.elder .rn { font-size:42rpx; }
.elder .rm, .elder .desc, .elder .note { font-size:32rpx; line-height:1.7; color:#486571; }
.elder .rt { color:#15566B; font-size:54rpx; }
.elder .btnrow { flex-wrap:wrap; }
.elder .btnrow .btn { flex:1 1 220rpx; }
.extra-large .rn { font-size:48rpx; }
.extra-large .rm, .extra-large .btn, .extra-large .mini { font-size:38rpx; }

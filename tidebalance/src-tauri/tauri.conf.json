{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TideBalance",
  "version": "0.1.0",
  "identifier": "com.yile.tidebalance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "潮衡 · 时间块与四象限",
        "width": 1280,
        "height": 820,
        "minWidth": 400,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "时间块与四象限",
    "longDescription": "潮衡：把「权衡」四象限与「潮汐」时间块合成一个本地优先的时间管理平台，支持插件扩展。Tauri 2 构建，可打包 Windows / Linux / Android。",
    "targets": ["nsis", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
